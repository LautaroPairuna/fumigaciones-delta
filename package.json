{
  "name": "fumigaciones-delta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "ffmpeg-static": "5.3.0",
    "file-type": "22.3.0",
    "leaflet": "1.9.4",
    "mariadb": "3.5.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.x",
    "dotenv": "18.0.10",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "ffmpeg-static": true,
    "prisma": true
  }
}
