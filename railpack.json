{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "...",
        "cp -r .next/static .next/standalone/.next/static",
        "cp -r public .next/standalone/public",
        "rm -f .next/standalone/.env*",
        "npx esbuild scripts/migrate.mjs --bundle --platform=node --format=cjs --log-level=warning --log-override:empty-import-meta=silent --outfile=.next/standalone/migrate.cjs",
        "mkdir -p .next/standalone/prisma && cp -r prisma/migrations .next/standalone/prisma/migrations",
        "test -f .next/standalone/migrate.cjs",
        "test -f .next/standalone/prisma/migrations/migration_lock.toml",
        "test -x .next/standalone/node_modules/ffmpeg-static/ffmpeg",
        "test -d .next/standalone/node_modules/sharp"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      { "step": "build", "include": [".next/standalone"] }
    ],
    "startCommand": "sh -c 'node .next/standalone/migrate.cjs; exec node --max-old-space-size=384 --max-semi-space-size=4 .next/standalone/server.js'",
    "variables": { "HOSTNAME": "0.0.0.0", "MALLOC_ARENA_MAX": "2" }
  }
}
